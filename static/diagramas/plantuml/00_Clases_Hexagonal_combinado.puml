@startuml Vista_general_hexagonal_por_microservicio
title Vista general hexagonal por microservicio
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #F9F8F5
  BorderColor #01696F
  ArrowColor #707070
}

class Frontend <<Cliente>> {
  React.js
}

class APIGateway <<Inbound Gateway>> {
  Amazon API Gateway
}

class UsuariosMS <<Microservicio Hexagonal>> {
  FastAPI
  BD Usuarios
}

class CursosRecursosMS <<Microservicio Hexagonal>> {
  FastAPI
  BD Cursos y Recursos
  S3
}

class TrazabilidadMS <<Microservicio Hexagonal>> {
  FastAPI
  BD Trazabilidad
}

class RecomendacionMS <<Microservicio Hexagonal>> {
  Python / pyKT
  BD Recomendación
}

class XaiMS <<Microservicio Hexagonal>> {
  Python
  BD XAI
}

class IntegracionLmsMS <<Microservicio Hexagonal>> {
  FastAPI
  BD Integración LMS
}

class EventBridge <<Event Bus>> {
}

class SQS <<Queue>> {
}

class Lambdas <<AWS Lambda>> {
  Moodle
  Interacciones
  Alertas
  Recursos
}

Frontend --> APIGateway : consume REST/HTTPS
APIGateway --> UsuariosMS : enruta solicitudes
APIGateway --> CursosRecursosMS : enruta solicitudes
APIGateway --> TrazabilidadMS : enruta solicitudes
APIGateway --> RecomendacionMS : enruta solicitudes
APIGateway --> XaiMS : enruta solicitudes
APIGateway --> IntegracionLmsMS : enruta solicitudes
RecomendacionMS ..> TrazabilidadMS : consulta historial
RecomendacionMS ..> CursosRecursosMS : consulta recursos
RecomendacionMS ..> XaiMS : solicita explicación
CursosRecursosMS ..> IntegracionLmsMS : consulta cursos LMS
TrazabilidadMS ..> IntegracionLmsMS : consulta interacciones LMS
UsuariosMS ..> EventBridge : publica eventos
CursosRecursosMS ..> EventBridge : publica eventos
TrazabilidadMS ..> EventBridge : publica eventos
RecomendacionMS ..> EventBridge : publica eventos
XaiMS ..> EventBridge : publica eventos
IntegracionLmsMS ..> EventBridge : publica eventos
EventBridge --> SQS : enruta eventos
SQS --> Lambdas : activa procesamiento
@enduml

@startuml Microservicio_de_Usuarios
title Microservicio de Usuarios
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #F9F8F5
  BorderColor #01696F
  ArrowColor #707070
}

class UsuariosController <<Inbound Adapter>> {
  +registrar()
  +login()
  +cerrarSesion()
  +recuperarPassword()
  +gestionarRoles()
}

class AutenticarUsuarioUseCase <<Use Case>> {
  +execute(correo, password)
}

class RegistrarUsuarioUseCase <<Use Case>> {
  +execute(datosRegistro)
}

class GestionarRolesUseCase <<Use Case>> {
  +asignarRol(usuarioId, rolId)
  +revocarRol(usuarioId, rolId)
}

class Usuario <<Domain>> {
  +UUID id
  +String correoInstitucional
  +String passwordHash
  +EstadoUsuario estado
  +validarCorreo()
  +activar()
  +bloquear()
}

class Rol <<Domain>> {
  +UUID id
  +String nombre
  +String descripcion
}

class Permiso <<Domain>> {
  +UUID id
  +String codigo
  +String descripcion
}

class Sesion <<Domain>> {
  +UUID id
  +UUID usuarioId
  +String jwtId
  +DateTime expiraEn
  +invalidar()
}

class UsuarioRepositoryPort <<Output Port>> {
  +findByCorreo(correo)
  +findById(id)
  +save(usuario)
}

class RolRepositoryPort <<Output Port>> {
  +findByNombre(nombre)
  +save(rol)
}

class TokenPort <<Output Port>> {
  +generar(usuario)
  +validar(token)
  +invalidar(token)
}

class EventPublisherPort <<Output Port>> {
  +publish(event)
}

class UsuarioPostgresAdapter <<Outbound Adapter>> {
  +findByCorreo(correo)
  +save(usuario)
}

class RolPostgresAdapter <<Outbound Adapter>> {
  +findByNombre(nombre)
  +save(rol)
}

class JwtAdapter <<Outbound Adapter>> {
  +generar(usuario)
  +validar(token)
}

class EventBridgeAdapter <<Outbound Adapter>> {
  +publish(event)
}

class UsuarioAutenticadoEvent <<Domain Event>> {
  +UUID usuarioId
  +String rol
  +DateTime occurredAt
}

